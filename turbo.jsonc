{
	"$schema": "https://v2-10-12.turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", ".vercel/output/**"],
		},
		"//#check:lint": { "cache": false },
		"//#check:format": { "cache": false },
		"//#check:types": { "cache": false },
		"dev": {
			"cache": false,
			"persistent": true,
		},
	},
}
