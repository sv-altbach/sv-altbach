# Club website (apps/web) — local defaults
# Copy to `.env` and fill in secrets as needed.

# Absolute origin of the Masters app (Club → Masters links)
VITE_MASTERS_URL=http://localhost:3001

# Resend (required for contact form submissions)
RESEND_API_KEY=
RESEND_DOMAIN=contact.svaltbach.de
INTERNAL_CONTACT_EMAIL=

# Optional Tumblr RSS override (defaults to svaltbach-blog Tumblr feed)
# TUMBLR_BLOG_FEED_URL=
