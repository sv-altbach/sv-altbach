{
	"$schema": "https://v2-9-18.turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"email-preview": {
			"cache": false,
			"persistent": true
		},
		"dev": {
			"with": ["email-preview"],
			"cache": false,
			"persistent": true
		},
		"build": {
			"outputs": [".output/**"]
		},
		"check:types": {
			"inputs": [
				"src/**/*.ts",
				"src/**/*.tsx",
				"emails/**/*.tsx",
				"vite.config.ts",
				"tsconfig.json"
			]
		}
	}
}
