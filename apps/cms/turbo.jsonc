{
	"$schema": "https://v2-9-18.turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"payload:migrate": {
			"cache": false,
			"persistent": false
		},
		"build": {
			"env": [
				"NEXT_PUBLIC_SERVER_URL",
				"PAYLOAD_SECRET",
				"BLOB_*",
				"DATABASE_*",
				"NEON_*",
				"PG*",
				"POSTGRES_*"
			],
			"dependsOn": ["payload:migrate"]
		},
		"typegen": {
			"inputs": ["src/**/*.ts", "src/**/*.tsx", "next.config.ts"],
			"outputs": [".next/types/**/*.ts"]
		},
		"check:types": {
			"inputs": ["src/**/*.ts", "src/**/*.tsx", "tsconfig.json"],
			"dependsOn": ["typegen"]
		}
	}
}
