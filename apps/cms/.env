# CMS (apps/cms) — public / local-only defaults.
# Secrets go in `.env.local` (gitignored). Empty keys below document required secrets.
#
# Dev server / admin: http://localhost:3003
# Optional Postgres: docker compose -f apps/cms/docker-compose.yml up -d
#
# Secrets stay on the CMS Vercel project only — do not copy into Club or Masters.

# Public origin of this CMS app (absolute URLs in emails / admin).
NEXT_PUBLIC_SERVER_URL=http://localhost:3003

# Local Docker Postgres (see docker-compose.yml). Override in `.env.local` if needed.
POSTGRES_URL=postgresql://postgres@127.0.0.1:54320/cms

# Secrets — set in `.env.local` for real local work / production.
PAYLOAD_SECRET=
BLOB_READ_WRITE_TOKEN=
