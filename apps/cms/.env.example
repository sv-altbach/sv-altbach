# CMS (apps/cms) — secrets stay on the CMS Vercel project only.
# Club (apps/web) and Masters stay DB-less; do not copy these into those apps.
#
# Dev server: http://localhost:3003
# Admin:      http://localhost:3003/admin
#
# Copy to `.env` for local development:
#   cp apps/cms/.env.example apps/cms/.env
#   docker compose -f apps/cms/docker-compose.yml up -d

# Postgres connection string (Vercel Postgres / Neon in production).
# Default matches apps/cms/docker-compose.yml (port 54320, user postgres, db cms).
POSTGRES_URL=postgresql://postgres@127.0.0.1:54320/cms

# Payload signs JWTs / cookies with this. Use a long random string in production.
PAYLOAD_SECRET=dev-only-change-me

# Vercel Blob read/write token (Storage → Blob on the CMS Vercel project).
# Optional locally: when unset, media uploads fall back to local disk storage.
# BLOB_READ_WRITE_TOKEN=

# Public origin of this CMS app (absolute URLs in emails / admin).
NEXT_PUBLIC_SERVER_URL=http://localhost:3003
