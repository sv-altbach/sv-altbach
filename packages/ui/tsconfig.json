{
	"extends": "@sv-altbach/typescript-config/tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"declaration": false,
		"declarationMap": false,
		"paths": {
			"@sv-altbach/ui/*": ["./src/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"exclude": ["node_modules"]
}
